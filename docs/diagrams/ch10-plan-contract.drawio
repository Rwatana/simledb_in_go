<mxfile host="app.diagrams.net" modified="2026-11-24T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="ch10-plan-contract" name="Plan contract">
    <mxGraphModel dx="1320" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Chapter 10 / Features 1–32: Plans and predicate estimates" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="25" width="1000" height="55" as="geometry"/></mxCell>
        <mxCell id="tree" value="Relational query tree&#xa;QueryPlanner turns QueryData into plans&#xa;BasicQueryPlanner composes table plans&#xa;BasicQueryPlanner expands stored views&#xa;BetterQueryPlanner chooses lower-cost joins&#xa;one plan per leaf or operator&#xa;ProductPlan unions child schemas&#xa;ProductPlan opens ProductScan&#xa;ProjectPlan selects output fields&#xa;ProjectPlan opens ProjectScan&#xa;ProjectPlan delegates block estimate&#xa;ProjectPlan delegates output estimate&#xa;ProjectPlan delegates distinct estimate&#xa;SelectPlan applies predicate&#xa;Schema() preserves child fields&#xa;BlocksAccessed inherits estimate&#xa;RecordsOutput divides by selectivity&#xa;DistinctValues uses predicate equalities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="280" height="355" as="geometry"/></mxCell>
        <mxCell id="tablePlan" value="TablePlan&#xa;table name + transaction&#xa;resolved record.Layout&#xa;Schema() exposes layout schema&#xa;Open() builds query.RecordScan&#xa;BlocksAccessed() reads StatInfo&#xa;RecordsOutput() reads StatInfo&#xa;DistinctValues(field) reads StatInfo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="plan" value="plan.Plan&#xa;&#xa;Open&#xa;BlocksAccessed&#xa;RecordsOutput&#xa;DistinctValues(field)&#xa;Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="485" y="190" width="350" height="240" as="geometry"/></mxCell>
        <mxCell id="scan" value="query.Scan&#xa;TablePlan: RecordScan adapter&#xa;SelectPlan: SelectScan filter&#xa;ProductPlan: ProductScan&#xa;ProjectPlan: ProjectScan&#xa;left-major Cartesian traversal&#xa;Open returns (Scan, error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="125" width="280" height="195" as="geometry"/></mxCell>
        <mxCell id="estimates" value="Plan metadata and schema&#xa;block-access estimate&#xa;TablePlan: table row estimate&#xa;SelectPlan: rows / predicate factor&#xa;SelectPlan distinct: 1 for constant; min for field equality&#xa;ProductPlan: B(left) + R(left) × B(right)&#xa;ProductPlan: R(left) × R(right)&#xa;ProductPlan distinct: route by child schema&#xa;ProductPlan: left/right schema union&#xa;ProjectPlan: selected schema&#xa;record.Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="390" width="280" height="250" as="geometry"/></mxCell>
        <mxCell id="updatePlanner" value="UpdatePlanner&#xa;parsed DML and DDL → (affected rows, error)&#xa;BasicUpdatePlanner: DELETE + UPDATE via selection&#xa;BasicUpdatePlanner: INSERT row, then write ordered fields&#xa;BasicUpdatePlanner: CREATE TABLE through metadata&#xa;BasicUpdatePlanner: CREATE VIEW through metadata&#xa;BasicUpdatePlanner: CREATE INDEX through metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="455" width="470" height="165" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Plan separates choosing a query tree&#xa;from executing its scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="420" y="625" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="represented by" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="tree" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="table leaf" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="tree" target="tablePlan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Schema() result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="tablePlan" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Open()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tablePlan" target="scan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="690"/><mxPoint x="1280" y="690"/><mxPoint x="1280" y="192"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="Open()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="plan" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="estimates and schema" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="plan" target="estimates"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="plan-time metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="estimates" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
