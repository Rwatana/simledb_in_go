    <mxCell id="rule" value="The timer only wakes the condition loop; the Manager mutex and retry decide success versus timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="765" width="960" height="55" as="geometry"/></mxCell>
