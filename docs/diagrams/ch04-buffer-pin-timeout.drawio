    <mxCell id="abort" value="return nil&#xa;&#xa;ErrPinTimeout&#xa;state unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="570" width="280" height="165" as="geometry"/></mxCell>
