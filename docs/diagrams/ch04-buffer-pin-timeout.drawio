    <mxCell id="title" value="Chapter 4 / Feature 26: Abort after the pin deadline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="800" height="50" as="geometry"/></mxCell>
    <mxCell id="unavailable" value="Pin attempt unavailable&#xa;&#xa;start one deadline timer&#xa;default: 10 seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="300" height="185" as="geometry"/></mxCell>
    <mxCell id="wait" value="Cond.Wait()&#xa;&#xa;Manager mutex released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="245" width="280" height="170" as="geometry"/></mxCell>
    <mxCell id="release" value="Final release before deadline&#xa;&#xa;Broadcast → retry&#xa;return pinned frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="105" width="310" height="190" as="geometry"/></mxCell>
