        <mxCell id="storage" value="Concrete index storage&#xa;hash or B-tree behavior is separate&#xa;duplicate ordering is implementation-defined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="460" height="100" as="geometry"/></mxCell>
