        <mxCell id="error" value="If commit fails, keep the current transaction. If successor START fails after commit, leave the service disconnected; return no ID." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="570" width="780" height="60" as="geometry" /></mxCell>
