  <diagram id="ch11-network-rpc-close" name="Network RPC close">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Chapter 11 / Network RPC session close" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1040" height="55" as="geometry" /></mxCell>
        <mxCell id="client" value="RPC client&#xa;SimpleDB.Close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="155" width="230" height="95" as="geometry" /></mxCell>
        <mxCell id="session" value="DriverService&#xa;active transaction 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="155" width="250" height="95" as="geometry" /></mxCell>
        <mxCell id="commit" value="Transaction.Commit&#xa;durable COMMIT record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;" vertex="1" parent="1"><mxGeometry x="700" y="155" width="270" height="95" as="geometry" /></mxCell>
        <mxCell id="closed" value="CloseResponse&#xa;session closed&#xa;no successor START" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=16;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="270" height="110" as="geometry" /></mxCell>
        <mxCell id="transport" value="net.Conn remains caller-owned&#xa;caller closes transport after RPC response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="310" height="90" as="geometry" /></mxCell>
        <mxCell id="error" value="If COMMIT fails, return the error and keep the transaction attached and the session open. Closed sessions reject Connect, Commit, Rollback, and repeated Close." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="575" width="780" height="75" as="geometry" /></mxCell>
        <mxCell id="e1" value="gob RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="client" target="session"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="session" target="commit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="success only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="commit" target="closed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="transport ownership stays with caller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="client" target="transport"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="failed commit: no state change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="commit" target="error"><mxGeometry relative="1" as="geometry" /></mxCell>
