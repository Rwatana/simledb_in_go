  <diagram id="chapter-04-buffer-pin-wait" name="Chapter 4 - Pin Wait"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value="Chapter 4 / Feature 25: Wait for an available buffer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="800" height="50" as="geometry"/></mxCell>
    <mxCell id="pin" value="Manager.Pin(target)&#xa;&#xa;lock Manager mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="255" width="260" height="155" as="geometry"/></mxCell>
    <mxCell id="attempt" value="tryToPinLocked&#xa;&#xa;cache hit or miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="255" width="260" height="155" as="geometry"/></mxCell>
    <mxCell id="success" value="Pinned&#xa;&#xa;return frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="250" height="145" as="geometry"/></mxCell>
    <mxCell id="error" value="I/O or WAL error&#xa;&#xa;return error immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="315" width="250" height="155" as="geometry"/></mxCell>
    <mxCell id="wait" value="No available frame&#xa;&#xa;Cond.Wait()&#xa;mutex released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="525" width="270" height="175" as="geometry"/></mxCell>
    <mxCell id="wake" value="Final unpin Broadcast&#xa;&#xa;reacquire mutex&#xa;loop and retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="525" width="260" height="175" as="geometry"/></mxCell>
    <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="pin" target="attempt"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge2" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="attempt" target="success"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge3" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="attempt" target="error"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge4" value="unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="attempt" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge5" value="wake" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="wait" target="wake"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge6" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="wake" target="attempt"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="rule" value="Pin never spins: unavailable attempts sleep, then recheck after every wakeup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="755" width="960" height="65" as="geometry"/></mxCell>
