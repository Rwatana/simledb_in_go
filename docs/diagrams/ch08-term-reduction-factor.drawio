        <mxCell id="title" value="Chapter 8 / Features 31–32: Predicate selectivity" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="25" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="estimator" value="Plan statistics&#xa;DistinctValues(field)&#xa;&#xa;left=field and right=field&#xa;use the larger estimate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="310" height="180" as="geometry"/></mxCell>
        <mxCell id="term" value="query.Term&#xa;ReductionFactor(estimator)&#xa;&#xa;field = field: max(left, right)&#xa;field = constant: field estimate&#xa;equal constants: 1&#xa;unequal constants: Integer.MAX_VALUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="170" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="predicate" value="query.Predicate&#xa;ReductionFactor&#xa;&#xa;starts at 1 and multiplies term estimates&#xa;using Java's 32-bit integer arithmetic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="430" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="boundary" value="query owns the small estimation interface&#xa;and does not import the planning package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="330" height="90" as="geometry"/></mxCell>
