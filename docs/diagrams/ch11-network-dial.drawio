        <mxCell id="title" value="Chapter 11 / Build a caller-owned network RPC client" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1040" height="55" as="geometry" /></mxCell>
