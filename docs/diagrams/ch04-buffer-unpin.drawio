        <mxCell id="rule" value="Only 1 → 0 returns available. Underflow is rejected without changing state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="880" height="90" as="geometry"/></mxCell>
