        <mxCell id="underflow" value="unpin at zero → error&#xa;pin count remains 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="445" width="300" height="110" as="geometry"/></mxCell>
