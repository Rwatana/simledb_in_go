        <mxCell id="two" value="Shared frame&#xa;&#xa;pin count = 2&#xa;IsPinned = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="185" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="one" value="Pinned frame&#xa;&#xa;pin count = 1&#xa;IsPinned = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="185" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="zero" value="Available frame&#xa;&#xa;pin count = 0&#xa;IsPinned = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="185" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="edge1" value="unpin() = false&#xa;still unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="two" target="one"><mxGeometry relative="1" as="geometry"/></mxCell>
