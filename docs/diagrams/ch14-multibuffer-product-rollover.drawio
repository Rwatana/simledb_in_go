        <mxCell id="retry" value="On failure, keep the boundary&lt;br&gt;retry cleanup or the same range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="end" value="At file end:&lt;br&gt;keep final chunk until Close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="230" height="80" as="geometry" /></mxCell>
