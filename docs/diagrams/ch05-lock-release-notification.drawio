  <diagram id="chapter-05-lock-release-notification" name="Chapter 5 - Lock Release Notification"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0"><root>
    <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value="Chapter 5 / Features 44 and 47: Lock release notifications" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="260" y="30" width="880" height="50" as="geometry"/></mxCell>
    <mxCell id="waiter" value="Registered lock waiter&#xa;&#xa;Cond.Wait()&#xa;releases LockTable mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="290" height="180" as="geometry"/></mxCell>
    <mxCell id="unlock" value="LockTable.Unlock&#xa;&#xa;under the same mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="280" height="170" as="geometry"/></mxCell>
    <mxCell id="partial" value="shared count &gt; 1&#xa;&#xa;decrement count&#xa;at count 1: broadcast only&#xa;for registered exclusive waiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="95" width="300" height="200" as="geometry"/></mxCell>
    <mxCell id="final" value="final shared or exclusive&#xa;&#xa;delete block entry&#xa;Cond.Broadcast()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="300" height="190" as="geometry"/></mxCell>
    <mxCell id="resume" value="Waiter reacquires mutex&#xa;&#xa;rechecks lock predicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="570" width="280" height="145" as="geometry"/></mxCell>
    <mxCell id="edge1" value="mutex released" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="waiter" target="unlock"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge2" value="not final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="unlock" target="partial"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge3" value="final release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="unlock" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge4" value="wake all" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="final" target="resume"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="rule" value="State mutation and Broadcast share the LockTable mutex; every waiter must recheck its predicate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="755" width="960" height="65" as="geometry"/></mxCell>
