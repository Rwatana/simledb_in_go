    <mxCell id="resume" value="Waiter reacquires mutex&#xa;&#xa;rechecks available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="495" y="565" width="270" height="145" as="geometry"/></mxCell>
    <mxCell id="edge1" value="mutex released" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="waiter" target="unpin"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge2" value="not final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=3;fontSize=16;" edge="1" parent="1" source="unpin" target="intermediate"><mxGeometry relative="1" as="geometry"/></mxCell>
