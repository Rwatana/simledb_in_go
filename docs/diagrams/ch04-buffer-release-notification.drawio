    <mxCell id="rule" value="The condition variable and available predicate share the Manager mutex; waiters always loop and recheck." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="750" width="960" height="65" as="geometry"/></mxCell>
