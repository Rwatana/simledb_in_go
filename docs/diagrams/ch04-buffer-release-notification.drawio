    <mxCell id="intermediate" value="pin count remains &gt; 0&#xa;&#xa;available unchanged&#xa;no broadcast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="300" height="170" as="geometry"/></mxCell>
