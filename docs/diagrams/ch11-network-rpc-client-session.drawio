        <mxCell id="ownership" value="The caller keeps the rpc.Client and transport&#xa;session creation does not commit, close, or replace the transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=15;" vertex="1" parent="1"><mxGeometry x="260" y="570" width="680" height="75" as="geometry" /></mxCell>
