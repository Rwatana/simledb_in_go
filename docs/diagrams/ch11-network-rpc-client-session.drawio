      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Chapter 11 / Connect a remote client session" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1040" height="55" as="geometry" /></mxCell>
        <mxCell id="caller" value="Caller&#xa;owns rpc.Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="55" y="165" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="connect" value="ConnectRPCSession&#xa;one Connect request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=16;" vertex="1" parent="1"><mxGeometry x="355" y="165" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="service" value="DriverService.Connect&#xa;create and retain transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=15;" vertex="1" parent="1"><mxGeometry x="675" y="165" width="275" height="100" as="geometry" /></mxCell>
