        <mxCell id="title" value="Chapter 9 / Feature 5: Match a keyword" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="30" width="780" height="55" as="geometry"/></mxCell>
        <mxCell id="input" value="SQL input&#xa;&#xa;SELECT users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=19;" vertex="1" parent="1"><mxGeometry x="45" y="215" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="peek" value="MatchKeyword(&quot;select&quot;)&#xa;&#xa;compare full word&#xa;input normalized lower-case&#xa;leave cursor unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1"><mxGeometry x="355" y="200" width="270" height="160" as="geometry"/></mxCell>
        <mxCell id="eat" value="EatKeyword(&quot;select&quot;)&#xa;&#xa;consume matching word&#xa;only on a match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="result" value="keyword consumed&#xa;next token = users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="error" value="unexpected word or token&#xa;error includes byte offset&#xa;cursor remains unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;" vertex="1" parent="1"><mxGeometry x="355" y="410" width="270" height="100" as="geometry"/></mxCell>
