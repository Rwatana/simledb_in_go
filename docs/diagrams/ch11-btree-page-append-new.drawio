<mxCell id="append" value="Append exactly one block&#xa;to the same file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="260" height="100" as="geometry"/></mxCell>
