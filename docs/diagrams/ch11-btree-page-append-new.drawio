<mxCell id="note" value="AppendNew does not pin or unpin; the caller owns the block lifecycle." style="text;html=1;align=center;fontSize=18;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="170" y="510" width="860" height="40" as="geometry"/></mxCell>
